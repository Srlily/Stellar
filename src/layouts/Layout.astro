---
import '../styles/global.css';
import { LIGHT_MODE, DARK_MODE, SYSTEM_MODE } from '../constants';
import { siteConfig } from '@/config/siteConfig';
import { backgroundConfig } from '@/config/backgroundConfig';
import Background from '@/components/Background.astro';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Stellar — Astro + Tailwind + Swup + Mermaid',
	description = '集成 Tailwind CSS、Swup 页面过渡与 Mermaid 图表的 Astro 站点',
} = Astro.props;

// 从 siteConfig 获取默认主题模式，确保类型为字符串
const defaultTheme: string = (siteConfig.theme as string) || SYSTEM_MODE;

// 液态玻璃视觉是否启用（与 light/dark 叠加，不再作为独立模式）
const glassEnabled = siteConfig.glassTheme?.enable ?? false;

// 序列化玻璃参数供客户端运行时使用（解决 SVG 滤镜需要 React DOM 的问题，改为 CSS 变量驱动）
const glassParams = glassEnabled
	? {
			refractionMode: siteConfig.glassTheme?.refractionMode ?? "standard",
			displacementScale: siteConfig.glassTheme?.displacementScale ?? 70,
			blurAmount: siteConfig.glassTheme?.blurAmount ?? 0.0625,
			saturation: siteConfig.glassTheme?.saturation ?? 140,
			aberrationIntensity: siteConfig.glassTheme?.aberrationIntensity ?? 2,
			cornerRadius: siteConfig.glassTheme?.cornerRadius ?? 24,
		}
	: null;

// 获取背景对齐方式
const align = backgroundConfig.align ?? "center";
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<script is:inline define:vars={{ LIGHT_MODE, DARK_MODE, SYSTEM_MODE, defaultTheme, glassEnabled, glassParams }}>
			// 主题模式：light / dark / system（三种循环）
			// 玻璃视觉作为叠加层，与 light/dark 同时生效，不再强制锁定
			(function () {
				var STORAGE_KEY = 'theme';
				var MODES = [LIGHT_MODE, DARK_MODE, SYSTEM_MODE];

				function getStoredMode() {
					try {
						return localStorage.getItem(STORAGE_KEY) || defaultTheme;
					} catch (_) {
						return defaultTheme;
					}
				}

				function resolveTheme(mode) {
					if (mode === DARK_MODE) return DARK_MODE;
					if (mode === LIGHT_MODE) return LIGHT_MODE;
					// system
					if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
						return DARK_MODE;
					}
					return LIGHT_MODE;
				}

				function applyGlassParams(params) {
					if (!params) return;
					var root = document.documentElement.style;
					root.setProperty('--glass-mode', params.refractionMode);
					root.setProperty('--glass-displacement', String(params.displacementScale));
					root.setProperty('--glass-blur-amount', String(params.blurAmount));
					root.setProperty('--glass-saturation', String(params.saturation));
					root.setProperty('--glass-aberration', String(params.aberrationIntensity));
					root.setProperty('--glass-radius', params.cornerRadius + 'px');
				}

				function applyTheme(mode) {
					var root = document.documentElement;

					// 解析后的实际主题（light / dark）始终应用，与玻璃叠加
					var resolved = resolveTheme(mode);
					if (resolved === DARK_MODE) {
						root.classList.add('dark');
					} else {
						root.classList.remove('dark');
					}
					root.dataset.theme = resolved;

					// 玻璃视觉作为独立 class 标记，便于 CSS 选择器处理
					if (glassEnabled) {
						root.classList.add('glass-theme');
						applyGlassParams(glassParams);
					} else {
						root.classList.remove('glass-theme');
					}
				}

				// 首次加载：立即应用，避免主题闪烁
				applyTheme(getStoredMode());
				document.dispatchEvent(new CustomEvent("theme-change", { detail: { mode: getStoredMode() } }));

				// 监听系统主题变化（仅在 system 模式下生效）
				if (window.matchMedia) {
					var mq = window.matchMedia('(prefers-color-scheme: dark)');
					var onSystemChange = function () {
						if (getStoredMode() === SYSTEM_MODE) {
							applyTheme(SYSTEM_MODE);
						}
					};
					if (mq.addEventListener) {
						mq.addEventListener('change', onSystemChange);
					} else if (mq.addListener) {
						mq.addListener(onSystemChange);
					}
				}

				// 暴露给 DarkModeToggle 使用
				window.__theme = {
					getMode: getStoredMode,
					setMode: function (mode) {
						try {
							localStorage.setItem(STORAGE_KEY, mode);
						} catch (_) {}
						applyTheme(mode);
						document.dispatchEvent(new CustomEvent("theme-change", { detail: { mode: mode } }));
					},
					cycleMode: function () {
						var current = getStoredMode();
						var idx = MODES.indexOf(current);
						var next = MODES[(idx + 1) % MODES.length];
						try {
							localStorage.setItem(STORAGE_KEY, next);
						} catch (_) {}
						applyTheme(next);
						document.dispatchEvent(new CustomEvent("theme-change", { detail: { mode: next } }));
						return next;
					},
					// 玻璃是否启用（只读，由配置决定）
					glassEnabled: glassEnabled,
					// 当前解析后的主题（light | dark），便于组件响应
					getResolved: function () {
						return resolveTheme(getStoredMode());
					},
				};

				// 启用过渡
				requestAnimationFrame(function () {
					document.documentElement.classList.add('theme-ready');
				});
			})();
		</script>
	</head>
	<body class="flex min-h-dvh flex-col bg-slate-50 text-slate-900 antialiased dark:bg-slate-950 dark:text-slate-100">
		<Background />
		<main id="swup" class={`flex flex-1 flex-col transition-fade${align === "center-center" ? " align-center-center" : ""}`}>
			<slot />
		</main>
		<slot name="footer" />
		{/* 滚动动画 Intersection Observer */}
		<script is:inline>
			(function () {
				function observeAnimations() {
					var els = document.querySelectorAll('.animate-on-scroll');
					if (!els.length) return;
					var observer = new IntersectionObserver(function (entries) {
						entries.forEach(function (entry) {
							if (entry.isIntersecting) {
								entry.target.classList.add('is-visible');
								observer.unobserve(entry.target);
							}
						});
					}, { threshold: 0.1 });
					els.forEach(function (el) {
						if (!el.classList.contains('is-visible')) {
							observer.observe(el);
						}
					});
				}
				if (document.readyState === 'loading') {
					document.addEventListener('DOMContentLoaded', observeAnimations);
				} else {
					observeAnimations();
				}
				document.addEventListener('swup:content', function () {
					setTimeout(observeAnimations, 50);
				});
			})();
		</script>
	</body>
</html>
