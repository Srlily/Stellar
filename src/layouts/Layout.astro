---
import '../styles/global.css';
import { LIGHT_MODE, DARK_MODE, SYSTEM_MODE } from '../constants';
import { siteConfig } from '@/config/siteConfig';
import { backgroundConfig } from '@/config/backgroundConfig';
import Background from '@/components/Background.astro';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Stellar — Astro + Tailwind + Swup + Mermaid',
	description = '集成 Tailwind CSS、Swup 页面过渡与 Mermaid 图表的 Astro 站点',
} = Astro.props;

// 从 siteConfig 获取默认主题模式，确保类型为字符串
const defaultTheme: string = (siteConfig.theme as string) || SYSTEM_MODE;

// 液态玻璃是否启用（独立配置，不在主题循环中）
const glassEnabled = siteConfig.glassTheme?.enable ?? false;

// 获取背景对齐方式
const align = backgroundConfig.align ?? "center";
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<script is:inline define:vars={{ LIGHT_MODE, DARK_MODE, SYSTEM_MODE, defaultTheme, glassEnabled }}>
			// 主题模式：light / dark / system（三种循环）
			// glassEnabled 为独立配置，启用后深浅色切换失效
			(function () {
				var STORAGE_KEY = 'theme';
				var MODES = [LIGHT_MODE, DARK_MODE, SYSTEM_MODE];

				function getStoredMode() {
					try {
						return localStorage.getItem(STORAGE_KEY) || defaultTheme;
					} catch (_) {
						return defaultTheme;
					}
				}

				function resolveTheme(mode) {
					if (mode === DARK_MODE) return DARK_MODE;
					if (mode === LIGHT_MODE) return LIGHT_MODE;
					// system
					if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
						return DARK_MODE;
					}
					return LIGHT_MODE;
				}

				function applyTheme(mode) {
					var root = document.documentElement;

					// glass 模式：添加 glass-theme 类，强制使用亮色底层
					if (glassEnabled) {
						root.classList.add('glass-theme');
						root.classList.remove('dark');
						root.dataset.theme = 'glass';
						return;
					}

					// 非 glass 模式：正常应用深浅色
					root.classList.remove('glass-theme');
					var resolved = resolveTheme(mode);
					if (resolved === DARK_MODE) {
						root.classList.add('dark');
					} else {
						root.classList.remove('dark');
					}
					root.dataset.theme = resolved;
				}

				// 首次加载：立即应用，避免主题闪烁
				applyTheme(getStoredMode());
				document.dispatchEvent(new CustomEvent("theme-change", { detail: { mode: getStoredMode() } }));

				// 监听系统主题变化（仅在 system 模式下生效）
				if (window.matchMedia) {
					var mq = window.matchMedia('(prefers-color-scheme: dark)');
					var onSystemChange = function () {
						if (getStoredMode() === SYSTEM_MODE) {
							applyTheme(SYSTEM_MODE);
						}
					};
					if (mq.addEventListener) {
						mq.addEventListener('change', onSystemChange);
					} else if (mq.addListener) {
						mq.addListener(onSystemChange);
					}
				}

				// 暴露给 DarkModeToggle 使用
				window.__theme = {
					getMode: getStoredMode,
					setMode: function (mode) {
						try {
							localStorage.setItem(STORAGE_KEY, mode);
						} catch (_) {}
						applyTheme(mode);
						document.dispatchEvent(new CustomEvent("theme-change", { detail: { mode: mode } }));
					},
					cycleMode: function () {
						var current = getStoredMode();
						var idx = MODES.indexOf(current);
						var next = MODES[(idx + 1) % MODES.length];
						try {
							localStorage.setItem(STORAGE_KEY, next);
						} catch (_) {}
						applyTheme(next);
						document.dispatchEvent(new CustomEvent("theme-change", { detail: { mode: next } }));
						return next;
					},
					// glass 是否启用（只读，由配置决定）
					glassEnabled: glassEnabled,
				};

				// 启用过渡
				requestAnimationFrame(function () {
					document.documentElement.classList.add('theme-ready');
				});
			})();
		</script>
	</head>
	<body class="flex min-h-screen flex-col bg-slate-50 text-slate-900 antialiased dark:bg-slate-950 dark:text-slate-100">
		<Background />
		<main id="swup" class={`flex-1 transition-fade${align === "center-center" ? " align-center-center" : ""}`}>
			<slot />
		</main>
		<slot name="footer" />
		{/* 滚动动画 Intersection Observer */}
		<script is:inline>
			(function () {
				function observeAnimations() {
					var els = document.querySelectorAll('.animate-on-scroll');
					if (!els.length) return;
					var observer = new IntersectionObserver(function (entries) {
						entries.forEach(function (entry) {
							if (entry.isIntersecting) {
								entry.target.classList.add('is-visible');
								observer.unobserve(entry.target);
							}
						});
					}, { threshold: 0.1 });
					els.forEach(function (el) {
						if (!el.classList.contains('is-visible')) {
							observer.observe(el);
						}
					});
				}
				if (document.readyState === 'loading') {
					document.addEventListener('DOMContentLoaded', observeAnimations);
				} else {
					observeAnimations();
				}
				document.addEventListener('swup:content', function () {
					setTimeout(observeAnimations, 50);
				});
			})();
		</script>
	</body>
</html>
