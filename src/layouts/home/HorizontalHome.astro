---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Avatar from "@/components/home/Avatar.astro";
import SocialLinks from "@/components/home/SocialLinks.astro";
import TimeWeatherCards from "@/components/home/TimeWeatherCards.astro";
import NavCards from "@/components/home/NavCards.astro";
import Footer from "@/components/Footer.astro";
---

<Layout title="首页 · Stellar">
	<section class="mx-auto flex w-full max-w-[100rem] flex-1 flex-col justify-center gap-12 px-6 py-12">
		<Header />
		<div class="w-full grid items-center gap-8 md:grid-cols-[1fr_1.3fr]">
			<div class="flex min-w-0 flex-col items-center justify-center gap-8">
				<Avatar />
				<SocialLinks />
			</div>
			<div class="flex min-w-0 flex-col gap-6">
				<TimeWeatherCards />
				<NavCards />
			</div>
		</div>
	</section>
	<Footer slot="footer" />
</Layout>