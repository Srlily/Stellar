---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Avatar from "@/components/home/Avatar.astro";
import SocialLinks from "@/components/home/SocialLinks.astro";
import NavCards from "@/components/home/NavCards.astro";
import Footer from "@/components/Footer.astro";
---

<Layout title="首页 · Stellar">
	<section class="mx-auto flex max-w-5xl flex-col gap-12 px-6 py-16">
		<Header />
		<div class="grid gap-12 md:grid-cols-2">
			<Avatar />
			<div class="flex flex-col gap-8">
				<SocialLinks class="-mt-2" />
				<NavCards />
			</div>
		</div>
	</section>
	<Footer slot="footer" />
</Layout>