---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Avatar from "@/components/home/Avatar.astro";
import SocialLinks from "@/components/home/SocialLinks.astro";
import TimeWeatherCards from "@/components/home/TimeWeatherCards.astro";
import NavCards from "@/components/home/NavCards.astro";
import SkillsProjects from "@/components/home/SkillsProjects.astro";
import Footer from "@/components/Footer.astro";
---

<Layout title="首页 · Stellar">
	{/* 第一页：头部 + 头像 + 社交链接 + 时间/天气 + 导航卡片
	 *
	 * 关键设计：每个 .page 是一个独立 section，flex 容器让内容垂直水平居中。
	 * page-content 用 mx-auto + content-center 保证短内容也居中。 */}
	<section class="page page-1">
		<div class="page-content mx-auto flex w-full max-w-6xl flex-col items-center justify-center gap-12 px-6 py-16">
			<div class="flex w-full flex-col items-center gap-12">
				<Header />
				<Avatar />
				<SocialLinks class="-mt-4" />
				<TimeWeatherCards />
				<NavCards />
			</div>
		</div>
	</section>

	{/* 第二页：技能与项目 + Footer */}
	<section class="page page-2">
		<div class="page-content mx-auto flex w-full max-w-6xl flex-col items-center justify-center gap-12 px-6 py-16">
			<div class="flex w-full flex-col items-center gap-12">
				<SkillsProjects />
			</div>
		</div>
		<Footer />
	</section>
</Layout>
