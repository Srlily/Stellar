---
import { siteConfig } from "@/config/siteConfig";
import VerticalHome from "@/layouts/home/VerticalHome.astro";
import HorizontalHome from "@/layouts/home/HorizontalHome.astro";

// 主页布局由 siteConfig.homeLayout 控制
// 可选值："vertical" | "horizontal"
const HomeLayout =
	siteConfig.homeLayout === "horizontal" ? HorizontalHome : VerticalHome;
---

<HomeLayout />