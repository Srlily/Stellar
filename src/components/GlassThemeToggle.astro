---
/**
 * 液态玻璃主题切换组件
 * 切换液态玻璃效果的开启/关闭状态
 */
import Icon from "./Icon.astro";
---

<button
	type="button"
	id="glass-theme-toggle"
	class:list={[
		"inline-flex h-9 w-9 items-center justify-center rounded-md border transition-colors",
		"border-slate-200 bg-white text-slate-600 hover:bg-slate-100",
		"dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700",
	]}
	aria-label="切换液态玻璃主题"
	title="液态玻璃主题"
>
	<!-- 玻璃开启图标 -->
	<span id="glass-icon-on" class="hidden">
		<Icon name="material-symbols:water-drop-rounded" size="1.125rem" />
	</span>

	<!-- 玻璃关闭图标 -->
	<span id="glass-icon-off" class="hidden">
		<Icon name="material-symbols:water-drop-outline-rounded" size="1.125rem" />
	</span>
</button>

<script>
	function updateGlassIcon(enabled: boolean) {
		const onIcon = document.getElementById("glass-icon-on");
		const offIcon = document.getElementById("glass-icon-off");

		if (!onIcon || !offIcon) return;

		if (enabled) {
			onIcon.classList.remove("hidden");
			offIcon.classList.add("hidden");
		} else {
			onIcon.classList.add("hidden");
			offIcon.classList.remove("hidden");
		}
	}

	function initGlassToggle() {
		const toggle = document.getElementById("glass-theme-toggle");
		if (!toggle) return;

		// 初始化图标
		if (window.__theme) {
			updateGlassIcon(window.__theme.getGlassEnabled());
		}

		// 绑定点击事件
		toggle.addEventListener("click", () => {
			if (window.__theme) {
				const newState = window.__theme.toggleGlass();
				updateGlassIcon(newState);
			}
		});

		// 监听液态玻璃主题变化事件
		document.addEventListener("glass-theme-change", ((e: CustomEvent) => {
			updateGlassIcon(e.detail.enabled);
		}) as EventListener);
	}

	// 页面加载时初始化
	initGlassToggle();

	// Swup 页面过渡后重新初始化
	document.addEventListener("swup:content", () => {
		initGlassToggle();
	});
</script>
