---
/**
 * 导航卡片组件
 * 展示站点快捷入口卡片
 * 
 * 图标优先级：
 * 1. image - 用户提供的图片 URL
 * 2. favicon - 自动解析网站的 favicon（通过获取网页 HTML 解析 link rel="icon"）
 * 3. icon - 配置的图标名称
 * 
 * 布局：每行显示指定数量的卡片，超出部分点击"更多"按钮显示弹窗
 */
import { homeConfig } from "@/config/homeConfig";
import { siteConfig } from "@/config/siteConfig";
import Icon from "@/components/Icon.astro";

// 液态玻璃视觉是否启用（与 light/dark 叠加，而非独立模式）
const glassEnabled = siteConfig.glassTheme?.enable ?? false;
// 玻璃统一卡片类名
const glassCardClass = glassEnabled ? "glass-card" : "";
// 玻璃统一图标容器类名
const glassTileClass = glassEnabled ? "glass-tile" : "";

interface Props {
	class?: string;
}

const { class: className = "" } = Astro.props;

// 获取导航卡片配置
const navCards = homeConfig.navCards;
const isEnabled = navCards?.enable !== false;
const cards = navCards?.items || [];
const columns = navCards?.columns || 4; // 默认每行4个
const showMoreButton = navCards?.showMoreButton !== false; // 默认显示更多按钮
const maxRows = navCards?.maxRows || 0; // 0 表示不限制行数
const autoFavicon = navCards?.autoFavicon !== false; // 默认自动解析 favicon
const faviconSize = navCards?.faviconSize || 48; // favicon 图标大小（单位px）
const iconSize = navCards?.iconSize || 24; // icon 图标大小（单位px）

// 卡片尺寸配置
const cardSize = navCards?.cardSize || {};
const iconBoxSize = cardSize.iconBox ?? 48; // 图标容器尺寸（px）
const cardPadding = cardSize.padding ?? 16; // 卡片内边距（px）
const cardRounded = cardSize.rounded ?? 16; // 卡片圆角（px）
const cardMinWidth = cardSize.minWidth ?? 0; // 卡片最小宽度（px），0 表示不限制

// 弹窗内图标缩放比例
const MODAL_ICON_SCALE = 0.8; // 弹窗内图标相对于原始尺寸的缩放比例
const ARROW_ICON_SCALE = 0.7; // 箭头图标相对于弹窗图标的缩放比例

// 过滤掉未配置或 URL 为空的卡片
const validCards = cards.filter((card) => card.url && card.url.trim() !== "");

// 检查是否有有效的图片 URL（非空字符串）
function hasValidImage(card: any): boolean {
	return card.image && card.image.trim() !== "";
}

// 从 HTML 中解析 favicon URL
async function fetchFaviconFromPage(pageUrl: string): Promise<string | null> {
	try {
		// 只处理外部链接
		if (pageUrl.startsWith("/")) return null;
		
		const response = await fetch(pageUrl, {
			headers: {
				'User-Agent': 'Mozilla/5.0 (compatible; Bot/0.1)'
			},
			signal: AbortSignal.timeout(5000)
		});
		
		if (!response.ok) return null;
		
		const html = await response.text();
		
		// 解析 link 标签中的 icon
		const iconMatches = html.match(/<link[^>]*rel=["'](?:shortcut )?icon["'][^>]*href=["']([^"']+)["']/gi);
		const appleTouchMatches = html.match(/<link[^>]*rel=["']apple-touch-icon["'][^>]*href=["']([^"']+)["']/gi);
		
		// 获取基础 URL 用于处理相对路径
		const baseUrl = new URL(pageUrl);
		
		// 优先使用 apple-touch-icon，其次是 icon
		const matches = [...(appleTouchMatches || []), ...(iconMatches || [])];
		
		for (const match of matches) {
			const hrefMatch = match.match(/href=["']([^"']+)["']/);
			if (hrefMatch) {
				let faviconUrl = hrefMatch[1];
				
				if (faviconUrl.startsWith("//")) {
					faviconUrl = baseUrl.protocol + faviconUrl;
				} else if (faviconUrl.startsWith("/")) {
					faviconUrl = baseUrl.origin + faviconUrl;
				} else if (!faviconUrl.startsWith("http")) {
					faviconUrl = baseUrl.origin + "/" + faviconUrl;
				}
				
				return faviconUrl;
			}
		}
		
		return `${baseUrl.origin}/favicon.ico`;
		
	} catch (error) {
		console.error(`Failed to fetch favicon for ${pageUrl}:`, error);
		return null;
	}
}

// 获取图标的 URL（使用 SSR 获取真实 favicon）
async function getCardWithFavicon(card: any) {
	// 如果未开启自动解析 favicon 或为内部链接，返回 null
	if (!autoFavicon || card.url.startsWith("/")) {
		return { ...card, faviconUrl: null };
	}
	
	const faviconUrl = await fetchFaviconFromPage(card.url);
	return { ...card, faviconUrl };
}

// 使用 Promise.all 并行获取所有外部链接的 favicon
const cardsWithFavicons = await Promise.all(validCards.map(getCardWithFavicon));

// 计算最大可用卡槽位数量
// showMoreButton 为 true 时，第一行预留一个位置给"更多"按钮，总共 columns 个卡槽
// showMoreButton 为 false 且 maxRows > 0 时，总共 maxRows * columns 个卡槽
// showMoreButton 为 false 且 maxRows 为 0 时，不限制
const maxTotalSlots = showMoreButton
	? columns
	: (maxRows > 0 ? columns * maxRows : cardsWithFavicons.length);

// 如果卡片数超出卡槽，最后一个卡槽留给"更多"按钮
const hasOverflow = cardsWithFavicons.length > maxTotalSlots;
const maxVisibleCards = hasOverflow ? maxTotalSlots - 1 : maxTotalSlots;

// 分离显示的卡片和更多的卡片
const visibleCards = cardsWithFavicons.slice(0, maxVisibleCards);
const modalCards = cardsWithFavicons.slice(maxVisibleCards);
const hasMore = modalCards.length > 0;
---

{isEnabled && validCards.length > 0 && (
	<>
		<style>
			.nav-cards-grid {
				grid-template-columns: repeat(2, minmax(0, 1fr));
			}
			@media (min-width: 1024px) {
				.nav-cards-grid {
					grid-template-columns: repeat(var(--nav-cols, 4), minmax(0, 1fr));
				}
			}
		</style>
		<section class:list={["w-full min-w-0 grid gap-4", className]}>
			{/* 主区域卡片 */}
			<div class="nav-cards-grid grid min-w-0 gap-4" style={`--nav-cols: ${columns};`}>
				{visibleCards.map((card, index) => (
					<div class:list={["card-item animate-on-scroll anim-fade-up", `stagger-${Math.min(index + 1, 8)}`]}>
						<a
							href={card.url}
							target={card.url.startsWith("/") ? "_self" : "_blank"}
							rel={card.url.startsWith("/") ? "" : "noopener noreferrer"}
							class:list={[
								"nav-card group/card relative flex items-center gap-3 overflow-hidden border transition-all duration-300 hover:scale-105 hover:border-primary-400 hover:shadow-lg hover:shadow-primary-500/20",
								glassCardClass
									|| "border-slate-200 bg-white/80 dark:border-slate-700 dark:bg-slate-800/80 dark:hover:border-primary-400",
							]}
							style={`padding: ${cardPadding}px; border-radius: ${cardRounded}px;${cardMinWidth ? ` min-width: ${cardMinWidth}px;` : ""}`}
						>
							{/* 图标/图片区域 */}
							<div class:list={[
								"flex shrink-0 items-center justify-center overflow-hidden rounded-xl",
								glassTileClass
									|| "bg-slate-100 dark:bg-slate-700",
							]}
							style={`width: ${iconBoxSize}px; height: ${iconBoxSize}px;`}
							>
								{hasValidImage(card) ? (
									<img
										src={card.image}
										alt={card.title}
										class="h-full w-full object-cover"
										loading="lazy"
										decoding="async"
									/>
								) : card.url.startsWith("/") ? (
									card.icon ? (
										<Icon name={card.icon} size={`${iconSize}px`} />
									) : (
										<Icon name="material-symbols:link" size={`${iconSize}px`} />
									)
								) : (
									<>
										{card.faviconUrl && (
											<img
												src={card.faviconUrl}
												alt={card.title}
												class="object-contain"
												loading="lazy"
												decoding="async"
												onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
												style={`display: flex; width: ${faviconSize}px; height: ${faviconSize}px;`}
											/>
										)}
										<span
											class:list={["items-center justify-center", card.faviconUrl ? "hidden" : "flex"]}
											style={card.faviconUrl ? `display: none;` : `display: flex;`}
										>
											{card.icon ? (
												<Icon name={card.icon} size={`${iconSize}px`} />
											) : (
												<Icon name="material-symbols:link" size={`${iconSize}px`} />
											)}
										</span>
									</>
								)}
							</div>

							{/* 文字内容 */}
							<div class="flex flex-col gap-1 min-w-0 flex-1">
								<h3 class:list={[
									"truncate font-medium text-slate-900 dark:text-slate-100",
									card.description ? "text-sm" : "text-base md:text-lg",
								]}>
									{card.title}
								</h3>
								{card.description && (
									<p class="truncate text-xs text-slate-500 dark:text-slate-400">
										{card.description}
									</p>
								)}
							</div>

							{/* 箭头图标 */}
							<div class="nav-card-arrow shrink-0 opacity-0 transition-opacity duration-300 group-hover/card:opacity-100">
								<Icon
									name="material-symbols:arrow-forward-rounded"
									size="1rem"
								/>
							</div>
						</a>
					</div>
				))}

				{/* 更多按钮 */}
				{hasMore && (
					<div class:list={["card-item animate-on-scroll anim-fade-up", `stagger-${Math.min(visibleCards.length + 1, 8)}`]}>
						<button
							type="button"
							class:list={[
								"nav-card group/card relative flex w-full items-center gap-3 overflow-hidden border transition-all duration-300 hover:scale-105 hover:border-primary-400 hover:shadow-lg hover:shadow-primary-500/20 cursor-pointer",
								glassCardClass
									|| "border-slate-200 bg-white/80 dark:border-slate-700 dark:bg-slate-800/80 dark:hover:border-primary-400",
							]}
							style={`padding: ${cardPadding}px; border-radius: ${cardRounded}px;${cardMinWidth ? ` min-width: ${cardMinWidth}px;` : ""}`}
							id="nav-cards-more-btn"
							aria-label={`查看更多 ${modalCards.length} 个链接`}
						>
							<div class:list={[
								"flex shrink-0 items-center justify-center overflow-hidden rounded-xl",
								glassTileClass
									|| "bg-slate-100 dark:bg-slate-700",
							]}
							style={`width: ${iconBoxSize}px; height: ${iconBoxSize}px;`}
							>
								<Icon name="material-symbols:add-rounded" size={`${iconSize}px`} />
							</div>
							<div class="flex flex-col gap-1 min-w-0 flex-1 text-left">
								<h3 class="truncate text-sm font-medium text-slate-900 dark:text-slate-100">
									查看更多
								</h3>
								<p class="truncate text-xs text-slate-500 dark:text-slate-400">
									还有 {modalCards.length} 个链接
								</p>
							</div>
						</button>
					</div>
				)}
			</div>
		</section>

		{/* 更多卡片弹窗 */}
		{hasMore && (
			<div
				id="nav-cards-modal"
				class="modal-backdrop"
				role="dialog"
				aria-modal="true"
				aria-labelledby="nav-cards-modal-title"
				aria-hidden="true"
			>
				<div
					id="nav-cards-modal-content"
					class="modal-content"
					tabindex="-1"
				>
					{/* 弹窗头部 */}
					<div class="modal-header">
						<h2 id="nav-cards-modal-title" class="modal-title">
							更多链接
						</h2>
						<button
							type="button"
							id="nav-cards-modal-close"
							class="modal-close"
							aria-label="关闭"
						>
							<Icon name="material-symbols:close-rounded" size="1.125rem" />
						</button>
					</div>

					{/* 更多卡片网格 */}
					<div class="modal-grid">
						{modalCards.map((card) => (
							<a
								href={card.url}
								target={card.url.startsWith("/") ? "_self" : "_blank"}
								rel={card.url.startsWith("/") ? "" : "noopener noreferrer"}
								class:list={[
									"nav-modal-card group/card relative flex items-center gap-3 overflow-hidden rounded-xl border p-3 transition-colors duration-200 hover:border-primary-400",
									glassEnabled
										? "border-white/20 bg-white/30"
										: "border-slate-200 bg-slate-50 dark:border-slate-700 dark:bg-slate-700/50 dark:hover:border-primary-400",
								]}
							>
								<div class:list={[
									"flex h-10 w-10 shrink-0 items-center justify-center overflow-hidden rounded-lg",
									glassTileClass || "bg-slate-100 dark:bg-slate-600",
								]}>
									{hasValidImage(card) ? (
										<img
											src={card.image}
											alt={card.title}
											class="h-full w-full object-cover"
											loading="lazy"
											decoding="async"
										/>
									) : card.url.startsWith("/") ? (
										card.icon ? (
											<Icon name={card.icon} size={`${iconSize * MODAL_ICON_SCALE}px`} />
										) : (
											<Icon name="material-symbols:link" size={`${iconSize * MODAL_ICON_SCALE}px`} />
										)
									) : (
										<>
											{card.faviconUrl && (
												<img
													src={card.faviconUrl}
													alt={card.title}
													class="object-contain"
													loading="lazy"
													decoding="async"
													onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
													style={`display: flex; width: ${faviconSize * MODAL_ICON_SCALE}px; height: ${faviconSize * MODAL_ICON_SCALE}px;`}
												/>
											)}
											<span
												class:list={["items-center justify-center", card.faviconUrl ? "hidden" : "flex"]}
												style={card.faviconUrl ? `display: none;` : `display: flex;`}
											>
												{card.icon ? (
													<Icon name={card.icon} size={`${iconSize * MODAL_ICON_SCALE}px`} />
												) : (
													<Icon name="material-symbols:link" size={`${iconSize * MODAL_ICON_SCALE}px`} />
												)}
											</span>
										</>
									)}
								</div>
								<div class="flex min-w-0 flex-1 flex-col gap-0.5">
									<span class="truncate text-sm font-medium text-slate-900 dark:text-slate-100">
										{card.title}
									</span>
									{card.description && (
										<span class="truncate text-xs text-slate-500 dark:text-slate-400">
											{card.description}
										</span>
									)}
								</div>
								<div class="nav-modal-card-arrow shrink-0 opacity-0 transition-opacity duration-200 group-hover/card:opacity-100">
									<Icon name="material-symbols:arrow-forward-rounded" size={`${iconSize * MODAL_ICON_SCALE * ARROW_ICON_SCALE}px`} />
								</div>
							</a>
						))}
					</div>
				</div>
			</div>
		)}

		{/* 弹窗控制脚本 */}
		{hasMore && (
			<script>
				(function () {
					const OPEN_ANIM_DURATION = 300;

					const moreBtn = document.getElementById("nav-cards-more-btn");
					const modal = document.getElementById("nav-cards-modal");
					const content = document.getElementById("nav-cards-modal-content");
					const closeBtn = document.getElementById("nav-cards-modal-close");

					if (!moreBtn || !modal || !content || !closeBtn) return;

					const _modal = modal as HTMLElement;
					const _content = content as HTMLElement;
					const _closeBtn = closeBtn as HTMLButtonElement;
					const _moreBtn = moreBtn as HTMLElement;

					// 将弹窗 DOM 移出 #smooth-content / #smooth-wrapper 容器，
					// 避免 GSAP ScrollSmoother 的 transform 影响 fixed 定位与 backdrop-filter 计算。
					document.body.appendChild(_modal);

					let lastFocused: HTMLElement | null = null;
					// 保留打开动画期间的入场 Web Animation 句柄，关闭时取消
					let openAnimations: Animation[] = [];

					function cancelOpenAnimations() {
						openAnimations.forEach((a) => a.cancel());
						openAnimations = [];
					}

					// 焦点陷阱：循环聚焦可聚焦元素
					function trapFocus(e: KeyboardEvent) {
						if (e.key !== "Tab" || !_modal.classList.contains("is-open")) return;

						const focusable = _modal.querySelectorAll<HTMLElement>(
							'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'
						);
						if (focusable.length === 0) return;

						const first = focusable[0];
						const last = focusable[focusable.length - 1];
						const active = document.activeElement as HTMLElement;

						if (e.shiftKey && active === first) {
							e.preventDefault();
							last.focus();
						} else if (!e.shiftKey && active === last) {
							e.preventDefault();
							first.focus();
						}
					}

					function openModal() {
						lastFocused = (document.activeElement as HTMLElement) ?? null;

						// 关键：清掉 closeModal 设置的 display:none，让弹窗可见
						_modal.style.display = "";

						// 立即设为初始态（透明 + 偏移），避免下一帧才看到的目标态闪烁
						_modal.style.opacity = "0";
						_content.style.opacity = "0";
						_content.style.transform = "translateY(20px) scale(0.96)";
						const modalCards = _content.querySelectorAll<HTMLElement>(".nav-modal-card");
						modalCards.forEach((card) => {
							(card as HTMLElement).style.opacity = "0";
							(card as HTMLElement).style.transform = "translateY(10px)";
						});

						// 添加 .is-open 让 display:flex / pointer-events:auto 生效
						_modal.classList.add("is-open");
						_content.classList.add("is-open");
						_modal.setAttribute("aria-hidden", "false");
						document.body.classList.add("modal-open");

						// 下一帧启动 WAAPI 动画（保证起始态被浏览器 paint 后才开始过渡）
						requestAnimationFrame(() => {
							openAnimations = [
								_modal.animate(
									[{ opacity: 0 }, { opacity: 1 }],
									{
										duration: OPEN_ANIM_DURATION,
										easing: "ease-out",
										fill: "forwards",
									}
								),
								_content.animate(
									[
										{ opacity: 0, transform: "translateY(20px) scale(0.96)" },
										{ opacity: 1, transform: "translateY(0) scale(1)" },
									],
									{
										duration: OPEN_ANIM_DURATION + 50,
										easing: "cubic-bezier(0.34, 1.4, 0.64, 1)",
										fill: "forwards",
									}
								),
							];

							modalCards.forEach((card, i) => {
								openAnimations.push(
									(card as HTMLElement).animate(
										[
											{ opacity: 0, transform: "translateY(10px)" },
											{ opacity: 1, transform: "translateY(0)" },
										],
										{
											delay: 50 + i * 50,
											duration: 250,
											easing: "cubic-bezier(0.22, 1, 0.36, 1)",
											fill: "forwards",
										}
									)
								);
							});

							_closeBtn.focus();
						});
					}

					function closeModal() {
						// ========== 根本性重构：关闭零延迟，所有操作同步执行 ==========
						// 不使用任何锁、RAF、setTimeout、transition——彻底消除卡顿和延迟。
						// 唯一的"等待"是浏览器下一帧 paint 时已经看不到弹窗（因为 display:none）。

						// 取消正在进行的入场动画，避免下一帧 paint 时回放
						cancelOpenAnimations();

						// 2. 同步隐藏弹窗 —— 用 display:none 直接消失
						// 这是最关键的一行：display:none 立即生效，无任何过渡
						_modal.style.display = "none";
						_modal.classList.remove("is-open");
						_content.classList.remove("is-open");
						_modal.setAttribute("aria-hidden", "true");
						document.body.classList.remove("modal-open");

						// 3. 清掉 GSAP hover / WAAPI 残留的 inline style
						// 关键：只清掉 GSAP 写入的 transform/opacity，不要清掉 Icon.astro 写入的 width/height
						_content.removeAttribute("style");
						_modal.removeAttribute("style");
						const modalCards = _content.querySelectorAll<HTMLElement>(".nav-modal-card");
						modalCards.forEach((card) => {
							card.style.transform = "";
							card.style.opacity = "";
							card.style.boxShadow = "";
							const icon = card.querySelector<HTMLElement>("[data-icon-container]");
							if (icon) {
								// Icon 组件自己管理 width/height/color，只清掉 GSAP 残留
								icon.style.transform = "";
								icon.style.transformOrigin = "";
								icon.style.opacity = "";
							}
							const arrow = card.querySelector<HTMLElement>(".nav-modal-card-arrow");
							if (arrow) {
								arrow.style.transform = "";
								arrow.style.opacity = "";
							}
						});

						// 4. kill GSAP tween（异步但不影响响应）
						const gsap = (window as any).gsap;
						if (gsap) {
							modalCards.forEach((card) => gsap.killTweensOf(card));
						}

						// 5. 立即恢复 focus（让 Tab 顺序回到正常）
						(lastFocused ?? _moreBtn).focus();
					}

					// 打开
					_moreBtn.addEventListener("click", openModal);

					// 关闭按钮
					_closeBtn.addEventListener("click", closeModal);

					// 点击背景关闭：使用 mousedown 阶段判断 + contains 检测，
					// 避免 click 阶段被某些边缘 case（focus 切换、pointer 状态）干扰导致需点击两次。
					function onModalPointerDown(e: MouseEvent) {
						const target = e.target as Node;
						// 点击事件源不在 _content 子树内 → 视为点击背景
						if (!_content.contains(target)) {
							e.stopPropagation();
							closeModal();
						}
					}
					_modal.addEventListener("mousedown", onModalPointerDown);

					// ESC 关闭 + Tab 焦点陷阱
					document.addEventListener("keydown", (e) => {
						if (!_modal.classList.contains("is-open")) return;
						if (e.key === "Escape") {
							e.preventDefault();
							closeModal();
						} else {
							trapFocus(e);
						}
					});
				})();
			</script>
		)}
	</>
)}

