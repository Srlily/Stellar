							{/* 图标/图片区域 */}
							<div class:list={[
								"flex shrink-0 items-center justify-center overflow-hidden rounded-xl",
								glassTileClass
									|| "bg-slate-100 dark:bg-slate-700",
							]}
							style={`width: ${iconBoxSize}px; height: ${iconBoxSize}px;`}
							>
								{hasValidImage(card) ? (
									<img
										src={card.image}
										alt={card.title}
										class="h-full w-full object-cover"
										loading="lazy"
										decoding="async"
									/>
								) : card.url.startsWith("/") ? (
									card.icon ? (
										<Icon name={card.icon} size={`${iconSize}px`} />
									) : (
										<Icon name="material-symbols:link" size={`${iconSize}px`} />
									)
								) : (
									<>
										{card.faviconUrl && (
											<img
												src={card.faviconUrl}
												alt={card.title}
												class="object-contain"
												loading="lazy"
												decoding="async"
												onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
												style={`display: flex; width: ${faviconSize}px; height: ${faviconSize}px;`}
											/>
										)}
										<span
											class:list={["items-center justify-center", card.faviconUrl ? "hidden" : "flex"]}
											style={card.faviconUrl ? `display: none;` : `display: flex;`}
										>
											{card.icon ? (
												<Icon name={card.icon} size={`${iconSize}px`} />
											) : (
												<Icon name="material-symbols:link" size={`${iconSize}px`} />
											)}
										</span>
									</>
								)}
							</div>

							{/* 文字内容 */}
							<div class="flex flex-col gap-1 min-w-0 flex-1">
								<h3 class:list={[
									"truncate font-medium text-slate-900 dark:text-slate-100",
									card.description ? "text-sm" : "text-base md:text-lg",
								]}>
									{card.title}
								</h3>
								{card.description && (
									<p class="truncate text-xs text-slate-500 dark:text-slate-400">
										{card.description}
									</p>
								)}
							</div>

							{/* 箭头图标 */}
							<div class="nav-card-arrow shrink-0 opacity-0 transition-opacity duration-300 group-hover/card:opacity-100">
								<Icon
									name="material-symbols:arrow-forward-rounded"
									size="1rem"
								/>
							</div>
						</a>
					</div>
				))}

				{/* 更多按钮 */}
				{hasMore && (
					<div class:list={["card-item animate-on-scroll anim-fade-up", `stagger-${Math.min(visibleCards.length + 1, 8)}`]}>
						<button
							type="button"
							class:list={[
								"nav-card group/card relative flex w-full items-center gap-3 overflow-hidden border transition-all duration-300 hover:scale-105 hover:border-primary-400 hover:shadow-lg hover:shadow-primary-500/20 cursor-pointer",
								glassCardClass
									|| "border-slate-200 bg-white/80 dark:border-slate-700 dark:bg-slate-800/80 dark:hover:border-primary-400",
							]}
							style={`padding: ${cardPadding}px; border-radius: ${cardRounded}px;${cardMinWidth ? ` min-width: ${cardMinWidth}px;` : ""}`}
							id="nav-cards-more-btn"
							aria-label={`查看更多 ${modalCards.length} 个链接`}
						>
							<div class:list={[
								"flex shrink-0 items-center justify-center overflow-hidden rounded-xl",
								glassTileClass
									|| "bg-slate-100 dark:bg-slate-700",
							]}
							style={`width: ${iconBoxSize}px; height: ${iconBoxSize}px;`}
							>
								<Icon name="material-symbols:add-rounded" size={`${iconSize}px`} />
							</div>
							<div class="flex flex-col gap-1 min-w-0 flex-1 text-left">
								<h3 class="truncate text-sm font-medium text-slate-900 dark:text-slate-100">
									查看更多
								</h3>
								<p class="truncate text-xs text-slate-500 dark:text-slate-400">
									还有 {modalCards.length} 个链接
								</p>
							</div>
						</button>
					</div>
				)}
			</div>
		</section>

		{/* 更多卡片弹窗 */}
		{hasMore && (
			<div
				id="nav-cards-modal"
				class:list={[
					"modal-backdrop fixed inset-0 z-50 hidden items-center justify-center p-4 backdrop-blur-sm",
					glassEnabled ? "bg-black/30" : "bg-black/50",
				]}
				aria-hidden="true"
			>
				<div class:list={[
					"modal-content max-h-[80vh] w-full max-w-2xl overflow-y-auto rounded-2xl border p-6 shadow-xl",
					glassEnabled
						? "glass-card border-white/30 bg-white/20 backdrop-blur-2xl shadow-black/10"
						: "border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-800",
				]}>
					{/* 弹窗头部 */}
					<div class="mb-4 flex items-center justify-between">
						<h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">
							更多链接
						</h2>
						<button
							type="button"
							id="nav-cards-modal-close"
							class="flex h-8 w-8 items-center justify-center rounded-lg text-slate-500 transition-colors hover:bg-slate-100 hover:text-slate-700 dark:text-slate-400 dark:hover:bg-slate-700 dark:hover:text-slate-200"
							aria-label="关闭"
						>
							<Icon name="material-symbols:close-rounded" size={`${iconSize * MODAL_ICON_SCALE}px`} />
						</button>
					</div>

					{/* 更多卡片网格 */}
					<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
						{modalCards.map((card) => (
							<a
								href={card.url}
								target={card.url.startsWith("/") ? "_self" : "_blank"}
								rel={card.url.startsWith("/") ? "" : "noopener noreferrer"}
								class:list={[
									"nav-modal-card group/card relative flex items-center gap-3 overflow-hidden rounded-xl border p-3 transition-colors duration-200 hover:border-primary-400",
									glassEnabled
										? "border-white/20 bg-white/30"
										: "border-slate-200 bg-slate-50 dark:border-slate-700 dark:bg-slate-700/50 dark:hover:border-primary-400",
								]}
							>
								<div class:list={[
									"flex h-10 w-10 shrink-0 items-center justify-center overflow-hidden rounded-lg",
									glassTileClass || "bg-slate-100 dark:bg-slate-600",
								]}>
									{hasValidImage(card) ? (
										<img
											src={card.image}
											alt={card.title}
											class="h-full w-full object-cover"
											loading="lazy"
											decoding="async"
										/>
									) : card.url.startsWith("/") ? (
										card.icon ? (
											<Icon name={card.icon} size={`${iconSize * MODAL_ICON_SCALE}px`} />
										) : (
											<Icon name="material-symbols:link" size={`${iconSize * MODAL_ICON_SCALE}px`} />
										)
									) : (
										<>
											{card.faviconUrl && (
												<img
													src={card.faviconUrl}
													alt={card.title}
													class="object-contain"
													loading="lazy"
													decoding="async"
													onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
													style={`display: flex; width: ${faviconSize * MODAL_ICON_SCALE}px; height: ${faviconSize * MODAL_ICON_SCALE}px;`}
												/>
											)}
											<span
												class:list={["items-center justify-center", card.faviconUrl ? "hidden" : "flex"]}
												style={card.faviconUrl ? `display: none;` : `display: flex;`}
											>
												{card.icon ? (
													<Icon name={card.icon} size={`${iconSize * MODAL_ICON_SCALE}px`} />
												) : (
													<Icon name="material-symbols:link" size={`${iconSize * MODAL_ICON_SCALE}px`} />
												)}
											</span>
										</>
									)}
								</div>
								<div class="flex min-w-0 flex-1 flex-col gap-0.5">
									<span class="truncate text-sm font-medium text-slate-900 dark:text-slate-100">
										{card.title}
									</span>
									{card.description && (
										<span class="truncate text-xs text-slate-500 dark:text-slate-400">
											{card.description}
										</span>
									)}
								</div>
								<div class="nav-modal-card-arrow shrink-0 opacity-0 transition-opacity duration-200 group-hover/card:opacity-100">
									<Icon name="material-symbols:arrow-forward-rounded" size={`${iconSize * MODAL_ICON_SCALE * ARROW_ICON_SCALE}px`} />
								</div>
							</a>
						))}
					</div>
				</div>
			</div>
		)}

		{/* 弹窗控制脚本 */}
		{hasMore && (
			<script is:inline>
				(function() {
					const moreBtn = document.getElementById('nav-cards-more-btn');
					const modal = document.getElementById('nav-cards-modal');
					const closeBtn = document.getElementById('nav-cards-modal-close');

					if (!moreBtn || !modal || !closeBtn) return;

					function openModal() {
						modal.classList.remove('hidden');
						modal.classList.add('flex');
						modal.setAttribute('aria-hidden', 'false');
						document.body.style.overflow = 'hidden';
						closeBtn.focus();
						requestAnimationFrame(function() {
							modal.classList.add('is-open');
							modal.querySelector('.modal-content').classList.add('is-open');
						});
					}

					function closeModal() {
						modal.classList.remove('is-open');
						var content = modal.querySelector('.modal-content');
						if (content) content.classList.remove('is-open');
						setTimeout(function() {
							modal.classList.add('hidden');
							modal.classList.remove('flex');
							modal.setAttribute('aria-hidden', 'true');
							document.body.style.overflow = '';
							moreBtn.focus();
						}, 250);
					}

					moreBtn.addEventListener('click', openModal);
					closeBtn.addEventListener('click', closeModal);

					// 点击背景关闭
					modal.addEventListener('click', function(e) {
						if (e.target === modal) {
							closeModal();
						}
					});

					// ESC 关闭
					document.addEventListener('keydown', function(e) {
						if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
							closeModal();
						}
					});
				})();
			</script>
		)}
	</>
)}

<script>
	import { initCardHover } from "@/utils/gsap";

	// 导航卡片的 GSAP 悬停动画（与时间/天气卡片同款）
	initCardHover([
		{
			selector: ".nav-card",
			// 链接小图标：轻微旋转放大
			iconAnim: { rotate: 12, scale: 1.15 },
			// 标题：轻微放大
			contentAnim: { scale: 1.05 },
			// 尾部箭头：右移并淡入
			arrowSelector: ".nav-card-arrow",
		},
		{
			selector: "#nav-cards-more-btn",
			// "查看更多" 的 + 图标：旋转 90° 变 ×
			iconAnim: { rotate: 90, scale: 1.15 },
			contentAnim: { scale: 1.05 },
		},
		{
			selector: ".nav-modal-card",
			iconAnim: { rotate: 12, scale: 1.15 },
			contentAnim: { scale: 1.05 },
			arrowSelector: ".nav-modal-card-arrow",
		},
	]);
</script>
