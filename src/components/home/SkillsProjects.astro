---
/**
 * 技能与项目选项卡组件
 * 展示技能熟练度和项目
 */
import { homeConfig } from "@/config/homeConfig";
import { siteConfig } from "@/config/siteConfig";
import Icon from "@/components/Icon.astro";

// 液态玻璃视觉是否启用（与 light/dark 叠加）
const glassEnabled = siteConfig.glassTheme?.enable ?? false;
const glassCardClass = glassEnabled ? "glass-card" : "";
const glassTileClass = glassEnabled ? "glass-tile" : "";

interface Props {
	class?: string;
}

const { class: className = "" } = Astro.props;

// 获取技能卡片配置
const skillCards = homeConfig.skillCards;
const skillEnabled = skillCards?.enable !== false;
const skills = skillCards?.items || [];
const skillColumns = skillCards?.columns || 4;
const iconSize = skillCards?.iconSize || 24;
const gradientColors = skillCards?.gradient?.colors;
const gradientDir = skillCards?.gradient?.direction || "right";
const hasGradient = Array.isArray(gradientColors) && gradientColors.length >= 2;

// 获取项目卡片配置
const projectCards = homeConfig.projectCards;
const projectEnabled = projectCards?.enable !== false;
const projects = projectCards?.items || [];
const projectColumns = projectCards?.columns || 3;
const projectShowMore = projectCards?.showMoreButton !== false;
const projectMaxRows = projectCards?.maxRows || 0;
const projectIconSize = projectCards?.iconSize || 24;

// 过滤技能
const validSkills = skills.filter((skill) => skill.name && skill.name.trim() !== "");

// 过滤项目
const validProjects = projects.filter((project) => project.name && project.name.trim() !== "" && project.url && project.url.trim() !== "");

// 计算项目分页
// showMoreButton 为 true 时，预留一个"更多"按钮位置
// showMoreButton 为 false 且 maxRows > 0 时，最多 maxRows 行
// showMoreButton 为 false 且 maxRows 为 0 时，不限制
const projectMaxSlots = projectShowMore
	? projectColumns
	: (projectMaxRows > 0 ? projectColumns * projectMaxRows : validProjects.length);
const projectHasOverflow = validProjects.length > projectMaxSlots;
const projectMaxVisible = projectHasOverflow ? projectMaxSlots - 1 : projectMaxSlots;
const visibleProjects = validProjects.slice(0, projectMaxVisible);
const modalProjects = validProjects.slice(projectMaxVisible);
const projectHasMore = modalProjects.length > 0;

// 转换方向
const directionMap: Record<string, string> = {
	left: "to left",
	right: "to right",
	center: "to right, var(--tw-gradient-stops)",
};
const cssDirection = directionMap[gradientDir] || "to right";

// 进度条样式
const progressStyle = hasGradient
	? `background: linear-gradient(${cssDirection}, ${gradientColors.join(", ")});`
	: "background-color: #22c55e;";

// 检查是否需要显示选项卡
const showTabs = skillEnabled && projectEnabled && validSkills.length > 0 && validProjects.length > 0;
const onlySkills = skillEnabled && validSkills.length > 0 && (!projectEnabled || validProjects.length === 0);
const onlyProjects = projectEnabled && validProjects.length > 0 && (!skillEnabled || validSkills.length === 0);

// 根据 columns 生成 Tailwind 类名
function getProjectGridClass(cols: number): string {
	const gridClasses: Record<number, string> = {
		2: "grid-cols-2",
		3: "grid-cols-3",
		4: "grid-cols-4",
		5: "grid-cols-5",
		6: "grid-cols-6",
	};
	return gridClasses[cols] || "grid-cols-4";
}
const projectGridClass = getProjectGridClass(projectColumns);
---

{showTabs && (
	<section class:list={[
		"rounded-2xl border p-6 animate-on-scroll anim-fade-up stagger-5",
		glassCardClass
			|| "border-slate-200 bg-white/80 dark:border-slate-700 dark:bg-slate-800/80",
		className,
	]}>
		{/* 选项卡标题 */}
		<div class:list={[
			"tabs-container relative mb-6 flex rounded-lg p-1",
			glassEnabled
				? "bg-white/10 backdrop-blur-sm"
				: "bg-slate-100 dark:bg-slate-700/50",
		]}>
			{/* 滑动指示器 */}
			<div id="tab-indicator" class:list={[
				"tab-indicator absolute top-1 h-[calc(100%-8px)] w-[calc(50%-4px)] rounded-md shadow-sm transition-all duration-300 ease-out",
				glassEnabled
					? "bg-white/20"
					: "bg-slate-200 dark:bg-slate-600",
			]}></div>
			{/* 技能按钮 */}
			<button
				type="button"
				class="tab-btn skill-tab relative z-10 flex flex-1 items-center justify-center gap-2 rounded-md px-4 py-2 text-sm font-medium text-slate-900 dark:text-slate-100 transition-colors duration-200"
				data-tab="skill"
			>
				<Icon name="material-symbols:build-outline-rounded" size="1rem" />
				技能点
			</button>
			{/* 项目按钮 */}
			<button
				type="button"
				class="tab-btn project-tab relative z-10 flex flex-1 items-center justify-center gap-2 rounded-md px-4 py-2 text-sm font-medium text-slate-500 dark:text-slate-400 transition-colors duration-200"
				data-tab="project"
			>
				<Icon name="material-symbols:folder-outline-rounded" size="1rem" />
				项目
			</button>
		</div>

		{/* 技能内容 */}
		<div id="skill-content" class="tab-content min-h-[200px]">
			<ul class={`relative grid gap-x-6 gap-y-3 ${skillColumns >= 4 ? 'md:grid-cols-2 lg:grid-cols-4' : skillColumns >= 3 ? 'md:grid-cols-2 lg:grid-cols-3' : 'md:grid-cols-2'}`}>
				{validSkills.map((skill, index) => (
					<li class:list={["skill-item flex flex-col gap-1.5 rounded-lg px-2 py-1.5 -mx-2 -my-1.5 transition-all duration-300 hover:scale-105 hover:bg-slate-50 dark:hover:bg-slate-700/30 cursor-default animate-on-scroll anim-progress", `stagger-${Math.min(index + 1, 8)}`]}>
						<div class="flex justify-between">
							<label class="text-xs font-medium text-slate-700 dark:text-slate-300">
								{skill.name}
							</label>
							<span class="text-xs font-medium text-slate-500 dark:text-slate-400">
								{skill.level || 0}%
							</span>
						</div>
						<div class="relative h-1.5 w-full overflow-hidden rounded-full bg-slate-200 dark:bg-slate-600">
							<div
								class="progress-bar-fill absolute h-full rounded-full"
								style={`${progressStyle} width: ${skill.level || 0}%;`}
							></div>
						</div>
					</li>
				))}
			</ul>
		</div>

		{/* 项目内容 */}
		<div id="project-content" class="tab-content hidden min-h-[200px]">
			<div class={`grid ${projectGridClass} gap-x-6 gap-y-3`}>
				{visibleProjects.map((project, index) => (
					<a
						href={project.url}
						target={project.url.startsWith("/") ? "_self" : "_blank"}
						rel={project.url.startsWith("/") ? "" : "noopener noreferrer"}
						class:list={[
							"group/card relative flex flex-col gap-3 overflow-hidden rounded-xl border p-4 transition-all duration-300 hover:scale-105 hover:border-primary-400 hover:shadow-lg hover:shadow-primary-500/20",
							glassEnabled
								? "border-white/20 bg-white/10 backdrop-blur-xl"
								: "border-slate-200 bg-slate-50 dark:border-slate-700 dark:bg-slate-700/50 dark:hover:border-primary-400",
							"animate-on-scroll anim-fade-up",
							`stagger-${Math.min(index + 1, 8)}`,
						]}
					>
						{/* 项目图片或图标 */}
						<div class:list={[
							"relative h-16 w-full overflow-hidden rounded-lg",
							glassTileClass || "bg-slate-100 dark:bg-slate-600",
						]}>
							{project.image ? (
								<img
									src={project.image}
									alt={project.name}
									class="h-full w-full object-cover transition-transform duration-300 group-hover/card:scale-105"
									loading="lazy"
									decoding="async"
								/>
							) : (
								<div class="flex h-full w-full items-center justify-center">
									{project.icon ? (
										<Icon name={project.icon} size={`${projectIconSize}px`} class="text-slate-400" />
									) : (
										<Icon name="material-symbols:folder-outline-rounded" size={`${projectIconSize}px`} class="text-slate-400" />
									)}
								</div>
							)}
						</div>

						{/* 项目信息 */}
						<div class="flex flex-col gap-1">
							<h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100 group-hover/card:text-primary-500 transition-colors">
								{project.name}
							</h3>
							{project.description && (
								<p class="line-clamp-1 text-xs text-slate-500 dark:text-slate-400">
									{project.description}
								</p>
							)}
						</div>

						{/* 项目标签 */}
						{project.tags && project.tags.length > 0 && (
							<div class="project-tags-container flex flex-nowrap gap-1 overflow-hidden">
								{project.tags.map((tag, index) => (
									<span class:list={[
										"project-tag inline-flex items-center whitespace-nowrap rounded-full px-2 py-0.5 text-[10px] font-medium",
										glassEnabled
											? "bg-white/20 text-slate-700"
											: "bg-slate-100 text-slate-600 dark:bg-slate-600 dark:text-slate-300",
									]} data-index={index}>
										{tag}
									</span>
								))}
							</div>
						)}
					</a>
				))}

				{/* 更多按钮 */}
				{projectHasMore && (
					<button
						type="button"
						class:list={[
							"group/card relative flex flex-col gap-3 overflow-hidden rounded-xl border p-4 transition-all duration-300 hover:scale-105 hover:border-primary-400 hover:shadow-lg hover:shadow-primary-500/20 cursor-pointer",
							glassEnabled
								? "border-white/20 bg-white/10 backdrop-blur-xl"
								: "border-slate-200 bg-slate-50 dark:border-slate-700 dark:bg-slate-700/50 dark:hover:border-primary-400",
							"animate-on-scroll anim-fade-up",
							`stagger-${Math.min(visibleProjects.length + 1, 8)}`,
						]}
						id="project-modal-open"
					>
						<div class:list={[
							"relative h-16 w-full overflow-hidden rounded-lg",
							glassTileClass || "bg-slate-100 dark:bg-slate-600",
						]}>
							<div class="flex h-full w-full items-center justify-center">
								<Icon name="material-symbols:add-rounded" size={`${projectIconSize}px`} class="text-slate-400" />
							</div>
						</div>
						<div class="flex flex-col gap-1">
							<h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100 group-hover/card:text-primary-500 transition-colors">查看更多</h3>
							<p class="line-clamp-1 text-xs text-slate-500 dark:text-slate-400">还有 {modalProjects.length} 个项目</p>
						</div>
						{/* 与项目卡片一致的标签占位容器（保持 grid 对齐高度一致） */}
						<div class="project-tags-container flex flex-nowrap gap-1 overflow-hidden" style="visibility: hidden;">
							<span class="project-tag inline-flex items-center whitespace-nowrap rounded-full px-2 py-0.5 text-[10px] font-medium">占位</span>
						</div>
					</button>
				)}
			</div>
		</div>

		{/* 选项卡脚本 */}
		<script>
			(function() {
				function initTab() {
					const skillTab = document.querySelector('.skill-tab');
					const projectTab = document.querySelector('.project-tab');
					const tabIndicator = document.getElementById('tab-indicator');
					const skillContent = document.getElementById('skill-content');
					const projectContent = document.getElementById('project-content');

					if (!skillTab || !projectTab || !tabIndicator || !skillContent || !projectContent) return;

				function switchTab(tab) {
					const isDark = document.documentElement.classList.contains('dark');
					const activeColor = isDark ? 'rgb(226, 232, 240)' : 'rgb(15, 23, 42)';
					const inactiveColor = isDark ? 'rgb(148, 163, 184)' : 'rgb(100, 116, 139)';

					if (tab === 'skill') {
						tabIndicator.style.left = '4px';
						skillTab.style.color = activeColor;
						skillTab.querySelector('svg').style.color = activeColor;
						projectTab.style.color = inactiveColor;
						projectTab.querySelector('svg').style.color = inactiveColor;
						projectContent.classList.add('hidden');
						skillContent.classList.remove('hidden');
					} else {
						tabIndicator.style.left = 'calc(50%)';
						projectTab.style.color = activeColor;
						projectTab.querySelector('svg').style.color = activeColor;
						skillTab.style.color = inactiveColor;
						skillTab.querySelector('svg').style.color = inactiveColor;
						skillContent.classList.add('hidden');
						projectContent.classList.remove('hidden');
						// 切换到项目选项卡时触发GSAP滚动动画和标签溢出检测
						requestAnimationFrame(function() {
							// 触发标签溢出检测
							document.dispatchEvent(new CustomEvent('check-tag-overflow'));
						});
					}
				}

				skillContent.style.transition = 'opacity 0.15s ease';
				projectContent.style.transition = 'opacity 0.15s ease';
				switchTab('skill');

				skillTab.addEventListener('click', () => switchTab('skill'));
				projectTab.addEventListener('click', () => switchTab('project'));

				// 项目弹窗控制：完全由下方第二个 <script> 处理（与 NavCards 逻辑一致）
				// 此处不重复绑定，避免双重触发
				}  // 关闭 initTab()

				// DOM ready 后初始化
				if (document.readyState === 'loading') {
					document.addEventListener('DOMContentLoaded', initTab);
				} else {
					initTab();
				}
			})();
		</script>
	</section>
)}

{onlySkills && (
	<section class:list={[
		"rounded-2xl border p-6 animate-on-scroll anim-fade-up stagger-5",
		glassCardClass
			|| "border-slate-200 bg-white/80 dark:border-slate-700 dark:bg-slate-800/80",
		className,
	]}>
		{/* 头部 */}
		<div class="mb-6 flex items-center gap-2">
			<Icon name="material-symbols:build-outline-rounded" size={`${iconSize}px`} class="text-primary-500" />
			<h2 class="text-sm font-medium text-slate-700 dark:text-slate-300">
				技能点
			</h2>
		</div>

		{/* 技能列表 */}
		<div class="min-h-[200px]">
			<ul class={`relative grid gap-x-6 gap-y-3 ${skillColumns >= 4 ? 'md:grid-cols-2 lg:grid-cols-4' : skillColumns >= 3 ? 'md:grid-cols-2 lg:grid-cols-3' : 'md:grid-cols-2'}`}>
				{validSkills.map((skill, index) => (
					<li class:list={["skill-item flex flex-col gap-1.5 rounded-lg px-2 py-1.5 -mx-2 -my-1.5 transition-all duration-300 hover:scale-105 hover:bg-slate-50 dark:hover:bg-slate-700/30 cursor-default animate-on-scroll anim-progress", `stagger-${Math.min(index + 1, 8)}`]}>
						<div class="flex justify-between">
							<label class="text-xs font-medium text-slate-700 dark:text-slate-300">
								{skill.name}
							</label>
							<span class="text-xs font-medium text-slate-500 dark:text-slate-400">
								{skill.level || 0}%
							</span>
						</div>
						<div class="relative h-1.5 w-full overflow-hidden rounded-full bg-slate-200 dark:bg-slate-600">
							<div
								class="progress-bar-fill absolute h-full rounded-full"
								style={`${progressStyle} width: ${skill.level || 0}%;`}
							></div>
						</div>
					</li>
				))}
			</ul>
		</div>
	</section>
)}

{onlyProjects && (
	<section class:list={[
		"rounded-2xl border p-6 animate-on-scroll anim-fade-up stagger-5",
		glassCardClass
			|| "border-slate-200 bg-white/80 dark:border-slate-700 dark:bg-slate-800/80",
		className,
	]}>
		{/* 头部 */}
		<div class="mb-6 flex items-center gap-2">
			<Icon name="material-symbols:folder-outline-rounded" size={`${projectIconSize}px`} class="text-primary-500" />
			<h2 class="text-base font-semibold text-slate-700 dark:text-slate-300">
				项目
			</h2>
		</div>

		{/* 项目列表 */}
		<div class="min-h-[200px]">
			<div class={`grid ${projectGridClass} gap-x-6 gap-y-3`}>
				{visibleProjects.map((project, index) => (
					<a
						href={project.url}
						target={project.url.startsWith("/") ? "_self" : "_blank"}
						rel={project.url.startsWith("/") ? "" : "noopener noreferrer"}
						class:list={[
							"group/card relative flex flex-col gap-3 overflow-hidden rounded-xl border p-4 transition-all duration-300 hover:scale-105 hover:border-primary-400 hover:shadow-lg hover:shadow-primary-500/20",
							glassEnabled
								? "border-white/20 bg-white/10 backdrop-blur-xl"
								: "border-slate-200 bg-slate-50 dark:border-slate-700 dark:bg-slate-700/50 dark:hover:border-primary-400",
							"animate-on-scroll anim-fade-up",
							`stagger-${Math.min(index + 1, 8)}`,
						]}
					>
						{/* 项目图片或图标 */}
						<div class:list={[
							"relative h-20 w-full overflow-hidden rounded-lg",
							glassTileClass || "bg-slate-100 dark:bg-slate-600",
						]}>
							{project.image ? (
								<img
									src={project.image}
									alt={project.name}
									class="h-full w-full object-cover transition-transform duration-300 group-hover/card:scale-105"
									loading="lazy"
									decoding="async"
								/>
							) : (
								<div class="flex h-full w-full items-center justify-center">
									{project.icon ? (
										<Icon name={project.icon} size="2rem" class="text-slate-400" />
									) : (
										<Icon name="material-symbols:folder-outline-rounded" size="2rem" class="text-slate-400" />
									)}
								</div>
							)}
						</div>

						{/* 项目信息 */}
						<div class="flex flex-col gap-1">
							<h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100 group-hover/card:text-primary-500 transition-colors">
								{project.name}
							</h3>
							{project.description && (
								<p class="line-clamp-1 text-xs text-slate-500 dark:text-slate-400">
									{project.description}
								</p>
							)}
						</div>

						{/* 项目标签 */}
						{project.tags && project.tags.length > 0 && (
							<div class="project-tags-container flex flex-nowrap gap-1 overflow-hidden">
								{project.tags.map((tag, index) => (
									<span class:list={[
										"project-tag inline-flex items-center whitespace-nowrap rounded-full px-2 py-0.5 text-[10px] font-medium",
										glassEnabled
											? "bg-white/20 text-slate-700"
											: "bg-slate-100 text-slate-600 dark:bg-slate-600 dark:text-slate-300",
									]} data-index={index}>
										{tag}
									</span>
								))}
							</div>
						)}
					</a>
				))}

				{/* 更多按钮 */}
				{projectHasMore && (
					<button
						type="button"
						class:list={[
							"group/card relative flex flex-col gap-3 overflow-hidden rounded-xl border p-4 transition-all duration-300 hover:scale-105 hover:border-primary-400 hover:shadow-lg hover:shadow-primary-500/20 cursor-pointer",
							glassEnabled
								? "border-white/20 bg-white/10 backdrop-blur-xl"
								: "border-slate-200 bg-slate-50 dark:border-slate-700 dark:bg-slate-700/50 dark:hover:border-primary-400",
							"animate-on-scroll anim-fade-up",
							`stagger-${Math.min(visibleProjects.length + 1, 8)}`,
						]}
						id="project-modal-open"
					>
						<div class:list={[
							"relative h-20 w-full overflow-hidden rounded-lg",
							glassTileClass || "bg-slate-100 dark:bg-slate-600",
						]}>
							<div class="flex h-full w-full items-center justify-center">
								<Icon name="material-symbols:add-rounded" size={`${projectIconSize}px`} class="text-slate-400" />
							</div>
						</div>
						<div class="flex flex-col items-start gap-1">
							<h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100 group-hover/card:text-primary-500 transition-colors">查看更多</h3>
							<p class="line-clamp-1 text-xs text-slate-500 dark:text-slate-400">还有 {modalProjects.length} 个项目</p>
						</div>
					</button>
				)}
			</div>
		</div>
	</section>
)}

{/* 项目弹窗 - 与 NavCards 完全相同的结构与脚本 */}
{projectHasMore && (
	<div
		id="project-modal"
		class="modal-backdrop"
		role="dialog"
		aria-modal="true"
		aria-labelledby="project-modal-title"
		aria-hidden="true"
	>
		<div
			id="project-modal-content"
			class="modal-content"
			tabindex="-1"
		>
			<div class="modal-header">
				<h2 id="project-modal-title" class="modal-title">更多项目</h2>
				<button
					type="button"
					id="project-modal-close"
					class="modal-close"
					aria-label="关闭"
				>
					<Icon name="material-symbols:close-rounded" size="1.25rem" />
				</button>
			</div>
			<div class="modal-grid">
				{modalProjects.map((project, index) => (
					<a
						href={project.url}
						target={project.url.startsWith("/") ? "_self" : "_blank"}
						rel={project.url.startsWith("/") ? "" : "noopener noreferrer"}
						class:list={[
							"nav-modal-card group/card relative flex flex-col gap-3 overflow-hidden rounded-xl border p-4 transition-all duration-300 hover:scale-105 hover:border-primary-400 hover:shadow-lg hover:shadow-primary-500/20",
							glassEnabled
								? "border-white/20 bg-white/10 backdrop-blur-xl"
								: "border-slate-200 bg-slate-50 dark:border-slate-700 dark:bg-slate-700/50 dark:hover:border-primary-400",
						]}
					>
						{/* 项目图片或图标（与页面项目卡片 <a> 完全一致） */}
						<div class:list={[
							"relative h-20 w-full overflow-hidden rounded-lg",
							glassTileClass || "bg-slate-100 dark:bg-slate-600",
						]}>
							{project.image ? (
								<img
									src={project.image}
									alt={project.name}
									class="h-full w-full object-cover transition-transform duration-300 group-hover/card:scale-105"
									loading="lazy"
									decoding="async"
								/>
							) : (
								<div class="flex h-full w-full items-center justify-center">
									{project.icon ? (
										<Icon name={project.icon} size="2rem" class="text-slate-400" />
									) : (
										<Icon name="material-symbols:folder-outline-rounded" size="2rem" class="text-slate-400" />
									)}
								</div>
							)}
						</div>

						{/* 项目信息（标题 + 描述） */}
						<div class="flex flex-col gap-1">
							<h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100 group-hover/card:text-primary-500 transition-colors">
								{project.name}
							</h3>
							{project.description && (
								<p class="line-clamp-1 text-xs text-slate-500 dark:text-slate-400">
									{project.description}
								</p>
							)}
						</div>

						{/* 项目标签 */}
						{project.tags && project.tags.length > 0 && (
							<div class="project-tags-container flex flex-nowrap gap-1 overflow-hidden">
								{project.tags.map((tag, tagIndex) => (
									<span class:list={[
										"project-tag inline-flex items-center whitespace-nowrap rounded-full px-2 py-0.5 text-[10px] font-medium",
										glassEnabled
											? "bg-white/20 text-slate-700"
											: "bg-slate-100 text-slate-600 dark:bg-slate-600 dark:text-slate-300",
									]} data-index={tagIndex}>
										{tag}
									</span>
								))}
							</div>
						)}
					</a>
				))}
			</div>
		</div>
	</div>
)}

{/* 项目弹窗控制脚本 - 与 NavCards 完全相同的逻辑 */}
<script>
	(function () {
		const OPEN_ANIM_DURATION = 300;

		const moreBtn = document.getElementById("project-modal-open");
		const modal = document.getElementById("project-modal");
		const content = document.getElementById("project-modal-content");
		const closeBtn = document.getElementById("project-modal-close");

		if (!moreBtn || !modal || !content || !closeBtn) return;

		const _modal = modal as HTMLElement;
		const _content = content as HTMLElement;
		const _closeBtn = closeBtn as HTMLButtonElement;
		const _moreBtn = moreBtn as HTMLElement;

		// 将弹窗 DOM 移出 #smooth-content / #smooth-wrapper 容器
		document.body.appendChild(_modal);

		let lastFocused: HTMLElement | null = null;
		let openAnimations: Animation[] = [];

		function cancelOpenAnimations() {
			openAnimations.forEach((a) => a.cancel());
			openAnimations = [];
		}

		function openModal() {
			lastFocused = (document.activeElement as HTMLElement) ?? null;

			// 关键：清掉 closeModal 设置的 display:none，让弹窗可见
			_modal.style.display = "";

			// 立即设为初始态（透明 + 偏移），避免下一帧才看到的目标态闪烁
			_modal.style.opacity = "0";
			_content.style.opacity = "0";
			_content.style.transform = "translateY(20px) scale(0.96)";
			const modalCards = _content.querySelectorAll<HTMLElement>(".nav-modal-card");
			modalCards.forEach((card) => {
				(card as HTMLElement).style.opacity = "0";
				(card as HTMLElement).style.transform = "translateY(10px)";
			});

			// 添加 .is-open 让 display:flex / pointer-events:auto 生效
			_modal.classList.add("is-open");
			_content.classList.add("is-open");
			_modal.setAttribute("aria-hidden", "false");
			document.body.classList.add("modal-open");

			// 下一帧启动 WAAPI 动画
			requestAnimationFrame(() => {
				openAnimations = [
					_modal.animate(
						[{ opacity: 0 }, { opacity: 1 }],
						{
							duration: OPEN_ANIM_DURATION,
							easing: "ease-out",
							fill: "forwards",
						}
					),
					_content.animate(
						[
							{ opacity: 0, transform: "translateY(20px) scale(0.96)" },
							{ opacity: 1, transform: "translateY(0) scale(1)" },
						],
						{
							duration: OPEN_ANIM_DURATION + 50,
							easing: "cubic-bezier(0.34, 1.4, 0.64, 1)",
							fill: "forwards",
						}
					),
				];

				modalCards.forEach((card, i) => {
					openAnimations.push(
						(card as HTMLElement).animate(
							[
								{ opacity: 0, transform: "translateY(10px)" },
								{ opacity: 1, transform: "translateY(0)" },
							],
							{
								delay: 50 + i * 50,
								duration: 250,
								easing: "cubic-bezier(0.22, 1, 0.36, 1)",
								fill: "forwards",
							}
						)
					);
				});

				_closeBtn.focus();
			});
		}

		function closeModal() {
			cancelOpenAnimations();

			_modal.style.display = "none";
			_modal.classList.remove("is-open");
			_content.classList.remove("is-open");
			_modal.setAttribute("aria-hidden", "true");
			document.body.classList.remove("modal-open");

			const modalCards = _content.querySelectorAll<HTMLElement>(".nav-modal-card");
			const gsap = (window as any).gsap;
			if (gsap) {
				modalCards.forEach((card) => gsap.killTweensOf(card));
			}

			modalCards.forEach((card) => {
				(card as HTMLElement).style.transform = "";
				(card as HTMLElement).style.opacity = "";
				const icon = card.querySelector<HTMLElement>("[data-icon-container]");
				if (icon) {
					icon.style.transform = "";
					icon.style.transformOrigin = "";
					icon.style.opacity = "";
				}
				const arrow = card.querySelector<HTMLElement>(".nav-modal-card-arrow");
				if (arrow) {
					arrow.style.transform = "";
					arrow.style.opacity = "";
				}
			});
			_content.removeAttribute("style");
			_modal.removeAttribute("style");
			modalCards.forEach((card) => {
				card.removeAttribute("style");
			});

			(lastFocused ?? _moreBtn).focus();
		}

		// 打开
		_moreBtn.addEventListener("click", openModal);

		// 关闭按钮
		_closeBtn.addEventListener("click", closeModal);

		// 点击背景关闭：点击发生在 .modal-content 之外的任何位置都关闭
		_modal.addEventListener("mousedown", (e: MouseEvent) => {
			const target = e.target as Node;
			if (!_content.contains(target)) {
				e.stopPropagation();
				closeModal();
			}
		});

		// ESC 关闭
		document.addEventListener("keydown", (e) => {
			if (!_modal.classList.contains("is-open")) return;
			if (e.key === "Escape") {
				e.preventDefault();
				closeModal();
			}
		});
	})();
</script>
