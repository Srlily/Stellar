---
import { readFileSync, existsSync } from "node:fs";
import { join } from "node:path";

const year = new Date().getFullYear();

// 尝试读取构建时生成的 version.json
// 文件在 .gitignore 中，首次 clone 后需执行 `pnpm build` 或 `node scripts/generate-version.js` 生成
const versionPath = join(process.cwd(), "src", "generated", "version.json");
let info = {
	version: "unknown",
	branch: "unknown",
	shortHash: "unknown",
	commitCount: 0,
	commitTime: "",
	isDev: true,
};

try {
	if (existsSync(versionPath)) {
		const raw = readFileSync(versionPath, "utf-8");
		info = JSON.parse(raw);
	}
} catch {
	// 保持默认值
}
---

<footer class="mx-auto w-full max-w-5xl px-6 py-6 text-center text-sm text-slate-500 animate-on-scroll anim-fade-up">
	<p>© {year} Stellar. All rights reserved.</p>
	<p class="mt-1 text-xs text-slate-400">
		{info.isDev && (
			<span class="inline-flex items-center gap-1">
				<span class="h-1.5 w-1.5 rounded-full bg-amber-500"></span>
				<span>{info.branch}</span>
				<span class="mx-1">·</span>
				<code>{info.version}</code>
			</span>
		)}
		{!info.isDev && (
			<code>{info.version}</code>
		)}
	</p>
</footer>
