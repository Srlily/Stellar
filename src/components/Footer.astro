---
import { execSync } from "node:child_process";
const year = new Date().getFullYear();

function getVersion() {
	try {
		// 获取当前分支
		const branch = execSync("git rev-parse --abbrev-ref HEAD", { encoding: "utf-8" }).trim();
		const commitCount = execSync("git rev-list --count HEAD", { encoding: "utf-8" }).trim();
		const shortHash = execSync("git rev-parse --short HEAD", { encoding: "utf-8" }).trim();
		const commitTime = execSync("git log -1 --format=%cd --date=short", { encoding: "utf-8" }).trim();

		if (branch === "main") {
			// 正式版：优先使用最近的 tag，没有则回退到 commit 数 + hash
			try {
				const tag = execSync("git describe --tags --abbrev=0", { encoding: "utf-8" }).trim();
				return { version: tag, branch, commitTime, shortHash, isDev: false };
			} catch {
				return { version: `1.0.0-${commitCount}-g${shortHash}`, branch, commitTime, shortHash, isDev: false };
			}
		}

		// dev 分支：dev-{commit数}-{短hash}
		return { version: `dev-${commitCount}-${shortHash}`, branch, commitTime, shortHash, isDev: true };
	} catch {
		return { version: "dev", branch: "unknown", commitTime: "", shortHash: "", isDev: true };
	}
}

const info = getVersion();
---

<footer class="mx-auto w-full max-w-5xl px-6 py-6 text-center text-sm text-slate-500 animate-on-scroll anim-fade-up">
	<p>© {year} Stellar. All rights reserved.</p>
	<p class="mt-1 text-xs text-slate-400">
		{info.isDev && (
			<span class="inline-flex items-center gap-1">
				<span class="h-1.5 w-1.5 rounded-full bg-amber-500"></span>
				<span>{info.branch}</span>
				<span class="mx-1">·</span>
				<code>{info.version}</code>
			</span>
		)}
		{!info.isDev && (
			<code>{info.version}</code>
		)}
	</p>
</footer>
