---
// 全局动画组件 - 使用 GSAP 实现所有动画效果
---

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { siteConfig } from "@/config/siteConfig";

  // 注册 ScrollTrigger 插件
  gsap.registerPlugin(ScrollTrigger);

  // 读取 pageScroll 配置（带默认值）
  const PAGE_SCROLL_CONFIG = {
    infiniteLoop: siteConfig.pageScroll?.infiniteLoop ?? true,
    scrollSnap: siteConfig.pageScroll?.scrollSnap ?? true,
    scrubDelay: siteConfig.pageScroll?.scrubDelay ?? 0.4,
  };

  // 暴露到全局，方便 Swup 页面切换后重新读取（虽然通常不需要）
  (window as any).__PAGE_SCROLL_CONFIG__ = PAGE_SCROLL_CONFIG;

  // 应用 scrollSnap 配置（关闭时移除 snap）
  if (!PAGE_SCROLL_CONFIG.scrollSnap) {
    document.documentElement.style.scrollSnapType = "none";
  }

  // 动画类型配置
  const animationTypes: Record<string, { fromVars: gsap.TweenVars; toVars: gsap.TweenVars; stagger?: number }> = {
    "anim-fade-up": {
      fromVars: { opacity: 0, y: 30 },
      toVars: { opacity: 1, y: 0, duration: 0.6, ease: "power2.out" },
    },
    "anim-fade": {
      fromVars: { opacity: 0 },
      toVars: { opacity: 1, duration: 0.5, ease: "power2.out" },
    },
    "anim-scale": {
      fromVars: { opacity: 0, scale: 0.85 },
      toVars: { opacity: 1, scale: 1, duration: 0.5, ease: "back.out(1.7)" },
    },
    "anim-slide-right": {
      fromVars: { opacity: 0, x: 20 },
      toVars: { opacity: 1, x: 0, duration: 0.5, ease: "power2.out" },
    },
    "anim-progress": {
      fromVars: { opacity: 0, y: 20 },
      toVars: { opacity: 1, y: 0, duration: 0.6, ease: "power2.out" },
    },
  };

  // 获取元素的交错延迟
  function getStaggerDelay(el: Element): number {
    const staggerClass = Array.from(el.classList).find((c) => c.startsWith("stagger-"));
    if (staggerClass) {
      const num = parseInt(staggerClass.replace("stagger-", ""), 10);
      return num * 0.05;
    }
    return 0;
  }

  // 初始化滚动触发的动画
  function initScrollAnimations() {
    const scrollAnimatedElements = document.querySelectorAll(".animate-on-scroll");

    scrollAnimatedElements.forEach((el) => {
      // 获取动画类型，默认为 fade-up
      const animType = Object.keys(animationTypes).find((type) =>
        el.classList.contains(type)
      ) || "anim-fade-up";

      const config = animationTypes[animType];
      const staggerDelay = getStaggerDelay(el);

      // 进度条特殊处理
      if (animType === "anim-progress") {
        const progressBar = el.querySelector(".progress-bar-fill");
        if (progressBar) {
          gsap.fromTo(
            el,
            { opacity: 0, y: 20 },
            {
              opacity: 1,
              y: 0,
              duration: 0.6,
              delay: staggerDelay,
              ease: "power2.out",
              scrollTrigger: {
                trigger: el,
                start: "top 85%",
                toggleActions: "play none none reverse",
              },
            }
          );
          gsap.fromTo(
            progressBar,
            { width: "0%" },
            {
              width: progressBar.getAttribute("data-width") || "100%",
              duration: 0.8,
              delay: staggerDelay + 0.1,
              ease: "power2.out",
              scrollTrigger: {
                trigger: el,
                start: "top 85%",
                toggleActions: "play none none reverse",
              },
            }
          );
        }
        return;
      }

      gsap.fromTo(
        el,
        config.fromVars,
        {
          ...config.toVars,
          delay: staggerDelay,
          scrollTrigger: {
            trigger: el,
            start: "top 85%",
            toggleActions: "play none none reverse",
          },
        }
      );
    });
  }

  // 页面进入动画
  function initPageAnimations() {
    // 页面加载时的主内容动画
    const animatedElements = document.querySelectorAll(".animate-on-enter");
    if (animatedElements.length > 0) {
      gsap.fromTo(
        animatedElements,
        { opacity: 0, y: 20 },
        {
          opacity: 1,
          y: 0,
          duration: 0.6,
          stagger: 0.08,
          ease: "power2.out",
        }
      );
    }

    // 初始化滚动动画
    initScrollAnimations();

    // Avatar 特殊缩放动画
    const avatarContainer = document.getElementById("avatar-container");
    if (avatarContainer) {
      gsap.fromTo(
        avatarContainer,
        { opacity: 0, scale: 0.8 },
        {
          opacity: 1,
          scale: 1,
          duration: 0.8,
          delay: 0.2,
          ease: "back.out(1.7)",
        }
      );
    }

    // 卡片悬停增强动画
    const cards = document.querySelectorAll(".card-item");
    cards.forEach((card) => {
      card.addEventListener("mouseenter", () => {
        gsap.to(card.querySelector("a"), {
          scale: 1.02,
          duration: 0.3,
          ease: "power2.out",
        });
      });
      card.addEventListener("mouseleave", () => {
        gsap.to(card.querySelector("a"), {
          scale: 1,
          duration: 0.3,
          ease: "power2.out",
        });
      });
    });

    // Social links 动画
    const socialLinks = document.querySelectorAll(".social-link-item");
    if (socialLinks.length > 0) {
      gsap.fromTo(
        socialLinks,
        { opacity: 0, x: -20 },
        {
          opacity: 1,
          x: 0,
          duration: 0.5,
          stagger: 0.1,
          delay: 0.5,
          ease: "power2.out",
        }
      );
    }
  }

  // 弹窗动画
  function initModalAnimations() {
    const modal = document.getElementById("nav-cards-modal");
    const modalContent = modal?.querySelector(".modal-content");

    if (modal && modalContent) {
      // 存储原始的打开/关闭方法
      const originalOpen = () => {
        modal.classList.remove("hidden");
        modal.classList.add("flex");
        modal.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";

        // GSAP 动画
        gsap.fromTo(
          modal,
          { opacity: 0 },
          { opacity: 1, duration: 0.25, ease: "power2.out" }
        );
        gsap.fromTo(
          modalContent,
          { opacity: 0, scale: 0.95, y: 20 },
          {
            opacity: 1,
            scale: 1,
            y: 0,
            duration: 0.3,
            delay: 0.1,
            ease: "back.out(1.2)",
          }
        );
      };

      const originalClose = () => {
        gsap.to(modal, { opacity: 0, duration: 0.2, ease: "power2.in" });
        gsap.to(modalContent, {
          opacity: 0,
          scale: 0.95,
          y: 20,
          duration: 0.2,
          ease: "power2.in",
          onComplete: () => {
            modal.classList.add("hidden");
            modal.classList.remove("flex");
            modal.setAttribute("aria-hidden", "true");
            document.body.style.overflow = "";
          },
        });
      };

      // 拦截现有的事件监听器
      const moreBtn = document.getElementById("nav-cards-more-btn");
      const closeBtn = document.getElementById("nav-cards-modal-close");

      if (moreBtn) {
        moreBtn.addEventListener("click", originalOpen);
      }
      if (closeBtn) {
        closeBtn.addEventListener("click", originalClose);
      }
    }
  }

  // 初始化
  function init() {
    // 先清理旧实例（包括 swup 切换累积的）
    destroyPageSystem();
    ScrollTrigger.getAll().forEach((t) => t.kill());
    // ScrollTrigger 默认监听 window 滚动，与原生滚动一致
    initPageSystem();
    initPageAnimations();
    initModalAnimations();
  }

  // ========== 两页式滚动系统（根本重构） ==========
  //
  // 设计原则：
  // 1. 使用浏览器原生滚动（scroll） + CSS scroll-snap-type
  //    → 滚动行为由浏览器负责，惯性、触摸板支持、滚动条都原生工作
  // 2. 滚动条隐藏（自定义 scrollbar 样式）
  // 3. 用 ScrollTrigger.scrub 控制两页切换动画（scrub 让动画与滚动同步）
  // 4. 不再用 ScrollSmoother（避免 fixed 容器与 modal 冲突、wheel 监听边缘 case）
  // 5. 不再需要"循环滚动"（CSS scroll-snap 自动对齐到最近页）
  //
  // 优势：
  // - 滚动性能最优（GPU 加速由浏览器决定）
  // - 与弹窗 (position: fixed) 0 冲突
  // - 移动端触摸滑动原生支持
  // - 代码量减少 70%

  let pageTriggers: ScrollTrigger[] = [];
  let pageResizeHandler: (() => void) | null = null;
  let loopWheelHandler: ((e: WheelEvent) => void) | null = null;
  let loopTouchStartHandler: ((e: TouchEvent) => void) | null = null;
  let loopTouchMoveHandler: ((e: TouchEvent) => void) | null = null;
  let loopTouchEndHandler: ((e: TouchEvent) => void) | null = null;
  let loopKeyHandler: ((e: KeyboardEvent) => void) | null = null;
  let isLooping = false;
  let touchStartY = 0;
  let touchStartScrollY = 0;
  let touchConsumed = false;

  /**
   * 初始化两页式滚动系统 + 无限循环
   * 条件：页面有 .page 元素（仅首页生效）
   */
  function initPageSystem() {
    if (!document.querySelector(".page")) return;

    const page1Content = document.querySelector<HTMLElement>(".page-1 .page-content");
    const page2Content = document.querySelector<HTMLElement>(".page-2 .page-content");
    const page1 = document.querySelector<HTMLElement>(".page-1");
    const page2 = document.querySelector<HTMLElement>(".page-2");
    if (!page1Content || !page2Content || !page1 || !page2) return;

    // 1. 第二页内容入场动画（随滚动方向改变 y 起点）
    // 关键性能优化：直接用 element.style 赋值，避免 gsap.set 的 scheduler 开销
    // GSAP.set 每次调用都会触发内部 ticker + queue，对每帧调用有 0.1-0.3ms 开销
    const enterTrigger = ScrollTrigger.create({
      trigger: ".page-2",
      start: "top bottom",
      end: "top 30%",
      scrub: PAGE_SCROLL_CONFIG.scrubDelay,
      onUpdate: (self) => {
        const dir = self.direction;
        const p = self.progress;
        const startY = dir === 1 ? 60 : -60;
        page2Content.style.transform = `translate3d(0, ${startY * (1 - p)}px, 0)`;
        page2Content.style.opacity = String(p);
      },
    });
    pageTriggers.push(enterTrigger);

    // 2. 第一页内容淡出（向下滚入第二页时）
    const leaveTrigger = ScrollTrigger.create({
      trigger: ".page-2",
      start: "top 80%",
      end: "top 20%",
      scrub: PAGE_SCROLL_CONFIG.scrubDelay,
      onUpdate: (self) => {
        const p = self.progress;
        page1Content.style.transform = `translate3d(0, ${-40 * p}px, 0)`;
        page1Content.style.opacity = String(1 - p);
      },
    });
    pageTriggers.push(leaveTrigger);

    // 3. 视口 resize 时刷新 ScrollTrigger
    pageResizeHandler = () => {
      ScrollTrigger.refresh();
    };
    window.addEventListener("resize", pageResizeHandler, { passive: true });

    // 4. 无限循环滚动（仅当配置启用时）
    if (PAGE_SCROLL_CONFIG.infiniteLoop) {
      initInfiniteLoop();
    }
  }

  /**
   * 无限循环滚动
   *
   * 行为：
   * - 滚到第二页底部（页面最底端）继续向下滚 → 立即跳回第一页顶部（视觉上是循环）
   * - 滚到第一页顶部（页面最顶端）继续向上滚 → 立即跳到第二页底部
   *
   * 实现：监听 wheel/touch/keydown，在 boundary 时用 scrollTo 瞬移到另一端，
   * 配合 GSAP 淡入淡出掩盖瞬移感。
   */
  function initInfiniteLoop() {
    const page1 = document.querySelector<HTMLElement>(".page-1");
    const page2 = document.querySelector<HTMLElement>(".page-2");
    const page1Content = document.querySelector<HTMLElement>(".page-1 .page-content");
    const page2Content = document.querySelector<HTMLElement>(".page-2 .page-content");
    if (!page1 || !page2 || !page1Content || !page2Content) return;

    const LOOP_DURATION = 0.5;
    const BOUNDARY_TOLERANCE = 50; // 加大容差，避免边界抖动

    function getMaxScroll(): number {
      return Math.max(
        0,
        document.documentElement.scrollHeight - window.innerHeight
      );
    }

    /**
     * 关键改进：循环瞬移后立即禁用 scroll-snap 一帧，防止 snap 反弹导致视觉抽搐
     * (snap 算法在瞬移后可能重新检测并 snap 到错误位置)
     */
    let snapDisabled = false;
    function disableSnapForOneFrame() {
      if (snapDisabled) return;
      snapDisabled = true;
      const html = document.documentElement;
      const original = html.style.scrollSnapType;
      html.style.scrollSnapType = "none";
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          html.style.scrollSnapType = original;
          snapDisabled = false;
        });
      });
    }

    /**
     * 向下溢出：从 page-2 底部 → page-1 顶部
     * 视觉：page-2 从底部滑出视野（opacity 0, y -60），page-1 从下方淡入
     */
    function loopToTop() {
      if (isLooping) return;
      isLooping = true;

      // 关键：循环动画期间禁用 ScrollTrigger + scroll-snap，避免与跳转动画冲突
      pageTriggers.forEach((t) => t.disable());
      disableSnapForOneFrame();

      // page-2 向上滑出
      gsap.to(page2Content, {
        y: -60,
        opacity: 0,
        duration: LOOP_DURATION,
        ease: "power2.in",
        overwrite: true,
      });
      // page-1 从下方出现
      gsap.fromTo(
        page1Content,
        { y: 80, opacity: 0 },
        { y: 0, opacity: 1, duration: LOOP_DURATION, ease: "power2.out", overwrite: true }
      );

      // 立即瞬移到顶部（使用 scrollTo 避免 hash 改变）
      window.scrollTo({ top: 0, behavior: "instant" as ScrollBehavior });

      setTimeout(() => {
        isLooping = false;
        // 清理动画 inline style（让 ScrollTrigger 重新接管）
        gsap.set([page1Content, page2Content], { clearProps: "transform,opacity" });
        // 重新启用 ScrollTrigger 并刷新（基于当前 scrollY 重新计算 progress）
        pageTriggers.forEach((t) => t.enable());
        ScrollTrigger.refresh();
      }, LOOP_DURATION * 1000);
    }

    /**
     * 向上溢出：从 page-1 顶部 → page-2 底部
     */
    function loopToBottom() {
      if (isLooping) return;
      isLooping = true;

      // 关键：循环动画期间禁用 ScrollTrigger + scroll-snap
      pageTriggers.forEach((t) => t.disable());
      disableSnapForOneFrame();

      // page-1 向下滑出
      gsap.to(page1Content, {
        y: 80,
        opacity: 0,
        duration: LOOP_DURATION,
        ease: "power2.in",
        overwrite: true,
      });
      // page-2 从上方出现
      gsap.fromTo(
        page2Content,
        { y: -60, opacity: 0 },
        { y: 0, opacity: 1, duration: LOOP_DURATION, ease: "power2.out", overwrite: true }
      );

      // 立即瞬移到底部
      window.scrollTo({
        top: getMaxScroll(),
        behavior: "instant" as ScrollBehavior,
      });

      setTimeout(() => {
        isLooping = false;
        gsap.set([page1Content, page2Content], { clearProps: "transform,opacity" });
        pageTriggers.forEach((t) => t.enable());
        ScrollTrigger.refresh();
      }, LOOP_DURATION * 1000);
    }

    // ====== 监听器 ======

    // 鼠标滚轮（passive:false 以便 preventDefault 阻止默认行为）
    loopWheelHandler = (e: WheelEvent) => {
      if (isLooping) {
        e.preventDefault();
        return;
      }
      const y = window.scrollY;
      const max = getMaxScroll();
      const delta = e.deltaY;

      // 向下溢出：滚到底部且继续向下
      if (delta > 0 && y >= max - BOUNDARY_TOLERANCE) {
        e.preventDefault();
        loopToTop();
      }
      // 向上溢出：滚到顶部且继续向上
      else if (delta < 0 && y <= BOUNDARY_TOLERANCE) {
        e.preventDefault();
        loopToBottom();
      }
    };
    window.addEventListener("wheel", loopWheelHandler, { passive: false });

    // 触摸：touchstart 记录起点，touchmove 检测边界，touchend 触发循环
    loopTouchStartHandler = (e: TouchEvent) => {
      if (e.touches.length !== 1) return;
      touchStartY = e.touches[0].clientY;
      touchStartScrollY = window.scrollY;
      touchConsumed = false;
    };
    loopTouchMoveHandler = (_e: TouchEvent) => {
      if (touchConsumed || isLooping) return;
      const y = window.scrollY;
      const max = getMaxScroll();

      // 用 scrollY 变化判断方向比 deltaY 更可靠（不同设备的 touch deltaY 不一致）
      if (touchStartScrollY <= BOUNDARY_TOLERANCE && y <= BOUNDARY_TOLERANCE) {
        // 已经在顶部且继续向上（touchStartScrollY 接近 0，touchY 增大）
        // 这里用 touchStartY - touchY > 50 作为"持续上拉"的阈值
        // touch 事件中 touchStartY - currentTouchY > 50 表示手指向下拉
        const currentTouch = _e.touches[0]?.clientY ?? touchStartY;
        if (touchStartY - currentTouch < -50) {
          touchConsumed = true;
          loopToBottom();
        }
      } else if (touchStartScrollY >= max - BOUNDARY_TOLERANCE && y >= max - BOUNDARY_TOLERANCE) {
        // 已经在底部且继续向下（手指向上推）
        const currentTouch = _e.touches[0]?.clientY ?? touchStartY;
        if (touchStartY - currentTouch > 50) {
          touchConsumed = true;
          loopToTop();
        }
      }
    };
    loopTouchEndHandler = () => {
      touchConsumed = false;
    };
    document.addEventListener("touchstart", loopTouchStartHandler, { passive: true });
    document.addEventListener("touchmove", loopTouchMoveHandler, { passive: true });
    document.addEventListener("touchend", loopTouchEndHandler, { passive: true });

    // 键盘：PageUp / PageDown / Home / End / Arrow
    loopKeyHandler = (e: KeyboardEvent) => {
      if (isLooping) return;
      // 排除输入框
      const target = e.target as HTMLElement;
      if (
        target.tagName === "INPUT" ||
        target.tagName === "TEXTAREA" ||
        target.isContentEditable
      ) {
        return;
      }
      const y = window.scrollY;
      const max = getMaxScroll();

      if ((e.key === "PageDown" || e.key === "ArrowDown") && y >= max - BOUNDARY_TOLERANCE) {
        e.preventDefault();
        loopToTop();
      } else if ((e.key === "PageUp" || e.key === "ArrowUp") && y <= BOUNDARY_TOLERANCE) {
        e.preventDefault();
        loopToBottom();
      } else if (e.key === "End" && y >= max - BOUNDARY_TOLERANCE) {
        e.preventDefault();
        loopToTop();
      } else if (e.key === "Home" && y <= BOUNDARY_TOLERANCE) {
        e.preventDefault();
        loopToBottom();
      }
    };
    window.addEventListener("keydown", loopKeyHandler);
  }

  /**
   * 清理：swup 页面切换前调用，销毁 ScrollTrigger 与循环滚动监听
   */
  function destroyPageSystem() {
    pageTriggers.forEach((t) => t.kill());
    pageTriggers = [];
    if (pageResizeHandler) {
      window.removeEventListener("resize", pageResizeHandler);
      pageResizeHandler = null;
    }
    if (loopWheelHandler) {
      window.removeEventListener("wheel", loopWheelHandler);
      loopWheelHandler = null;
    }
    if (loopTouchStartHandler) {
      document.removeEventListener("touchstart", loopTouchStartHandler);
      loopTouchStartHandler = null;
    }
    if (loopTouchMoveHandler) {
      document.removeEventListener("touchmove", loopTouchMoveHandler);
      loopTouchMoveHandler = null;
    }
    if (loopTouchEndHandler) {
      document.removeEventListener("touchend", loopTouchEndHandler);
      loopTouchEndHandler = null;
    }
    if (loopKeyHandler) {
      window.removeEventListener("keydown", loopKeyHandler);
      loopKeyHandler = null;
    }
    isLooping = false;
  }

  // 页面加载完成后初始化
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }

  // SWUP 页面切换后重新初始化动画
  document.addEventListener("swup:content", () => {
    // 先清理旧的 ScrollTrigger，避免重复注册导致内存泄漏
    destroyPageSystem();
    ScrollTrigger.getAll().forEach((t) => t.kill());
    setTimeout(init, 100);
  });
</script>
